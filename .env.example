# Application
NODE_ENV=development
APP_ENV=development
APP_URL=http://127.0.0.1:4187
APP_HOST=127.0.0.1
APP_PORT=4187
DATABASE_PATH=./data/eventum-cache.json
LOG_LEVEL=info

# GenLayer runtime configuration (the only Eventum contract source of truth)
GENLAYER_NETWORK=studionet
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
# Replace with the active deployment address from your environment.
GENLAYER_CONTRACT_ADDRESS=0x96F23489C251135965b13303A991b2B9579bdF19
GENLAYER_EXPLORER_URL=https://explorer-studio.genlayer.com/
GENLAYER_STUDIO_URL=https://studio.genlayer.com/contracts

# Deployment-only server secret. Never expose this as NEXT_PUBLIC_*.
DEPLOYER_PRIVATE_KEY=

# Provider
POLYMARKET_GAMMA_API_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_GAMMA_API_ALLOWED_HOSTS=gamma-api.polymarket.com
POLYMARKET_ALLOWED_HOSTS=polymarket.com,www.polymarket.com

# Security / runtime
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=1000000
MAX_REQUEST_BODY_BYTES=65536
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Optional populated-deployment verifier fixtures. Leave empty for a fresh
# deployment and use artifacts/final/current-contract-read-matrix.md instead.
EVENTUM_VERIFY_SNAPSHOT_A=78f1e8ff6a146d9f551867efb40614adab473d2f96af529e3f9f918f3977a4f5
EVENTUM_VERIFY_SNAPSHOT_B=976cebb552d3d7af8bc3956e0276204803e717a396972561d3e9cd9dc84d0315
EVENTUM_VERIFY_COMPARISON_ID=57b3949e099f3cb1094631f79978d39ed2de1b83c7aa1a09ea00bae84431898c
